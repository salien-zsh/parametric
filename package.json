{
  "name": "parametric",
  "version": "0.4.78",
  "description": "Parametric: feature-based 3D part design, assembly and engineering drawings in the browser. Sketch with constraints, build B-rep features, place parts in assemblies and export STEP, STL, SVG or PDF.",
  "type": "module",
  "private": true,
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salien-zsh/parametric.git"
  },
  "homepage": "https://github.com/salien-zsh/parametric",
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:licenses": "node tools/check-licenses.mjs",
    "prebuild": "npm run check:licenses",
    "desktop": "electron .",
    "desktop:build": "npm run build && electron-builder --win nsis --publish never",
    "desktop:build:portable": "npm run build && electron-builder --win portable --publish never",
    "desktop:release": "npm run desktop:build",
    "desktop:publish": "npm run build && electron-builder --win nsis --publish always",
    "i18n:extract": "node tools/i18n/codemod.mjs",
    "i18n:dict": "node tools/i18n/build-dict.mjs",
    "i18n:check": "node tools/i18n/check.mjs",
    "test:no-cache": "vitest run --fsModuleCache=false --cache=false"
  },
  "dependencies": {
    "lucide": "1.55.0",
    "electron-updater": "6.6.2",
    "replicad": "1.1.0",
    "replicad-opencascadejs": "1.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "axe-core": "4.14.0",
    "electron": "^38.2.2",
    "electron-builder": "^26.0.12",
    "jsdom": "30.1.2",
    "typescript": "7.0.2",
    "typescript-codemod": "npm:typescript@^5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "build": {
    "appId": "cn.parametric.desktop",
    "productName": "参数化三维设计",
    "directories": {
      "output": "desktop-release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json",
      "public/licenses/**/*"
    ],
    "asar": true,
    "npmRebuild": false,
    "compression": "normal",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "artifactName": "Parametric-Desktop-Setup-${version}.${ext}",
      "shortcutName": "参数化三维设计"
    },
    "portable": {
      "artifactName": "Parametric-Desktop-Portable.exe"
    },
    "generateUpdatesFilesForAllChannels": true,
    "publish": [
      {
        "provider": "github",
        "owner": "salien-zsh",
        "repo": "parametric",
        "releaseType": "release"
      }
    ]
  }
}
